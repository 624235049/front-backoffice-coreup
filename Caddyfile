# Static SPA server for the CoreUp-team back office (see Dockerfile).
# TLS is terminated by Railway's edge, so Caddy only speaks plain HTTP on $PORT.
# Optional env: API_ORIGIN (e.g. https://api.coreup.example) and FILES_ORIGIN (the S3 endpoint the API presigns
# uploads for, e.g. https://t3.storageapi.dev) are appended to CSP connect-src;
# API_UPSTREAM (default api.railway.internal:8787) is where /v1/* is proxied.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Liveness endpoint for Railway / uptime monitors.
	handle /healthz {
		respond "ok" 200
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' {$API_ORIGIN:} {$FILES_ORIGIN:} https://*.sentry.io; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Same-origin API: /v1/* goes to the api service over Railway's private network, so the session cookie is
	# first-party for this site (works on *.up.railway.app without a shared parent domain). Build with VITE_API_URL
	# empty so the SPA calls relative /v1/... URLs. API_UPSTREAM = <api private host>:<api PORT>.
	handle /v1/* {
		reverse_proxy {$API_UPSTREAM:api.railway.internal:8787} {
			# While the api restarts (deploy/crash) dials fail. Keep retrying for up to 20s instead of answering 502.
			# Caddy only retries a request that never reached an upstream (dial/connect failure), so this is safe
			# for every method, POST included.
			lb_try_duration 20s
			lb_try_interval 250ms

			transport http {
				# Drop idle upstream connections after 30s, well before the api's keep-alive timeout (75s,
				# apps/api/src/index.ts): the proxy must always be the side that closes an idle connection, otherwise
				# it can reuse a socket the api just closed and fail with `EOF` (502 to the browser).
				keepalive 30s
				# Fail a dial fast (3s) so lb_try_interval retries land on the new instance quickly.
				dial_timeout 3s
			}
		}
	}

	# Hashed build output: cache forever; a missing asset must 404, not fall back to index.html.
	handle /assets/* {
		@hit file
		header @hit Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: real file if it exists, otherwise the SPA shell (client-side routing).
	# Always revalidate (ETag) so index.html / sw.js / manifest never go stale after a deploy.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
